# ─── DB ─────────────────────────────────────────────────────
# Docker 전체 실행 시
DB_HOST=db
# 로컬 직접 실행 시
# DB_HOST=localhost
DB_PORT=3306
DB_USER=DB유저명
DB_PASSWORD=DB비밀번호
DB_NAME=DB이름

# ─── 외부 RETINA API ────────────────────────────────────────────────
EXTERNAL_API_BASE_URL=https://외부api주소.com

# ─── AI 서버 ─────────────────────────────────────────────────
AI_SERVER_URL=http://ai:8001

# ─── 앱 ──────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=프론트 url

# ─── DB 컨테이너 생성용 ───────────────
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ─── AWS S3 ──────────────────────────
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=./private_key.pem

# ─── 관리자 ───────────────────────────────────────────────────
ADMIN_ID=
ADMIN_PASSWORD=
SECRET_KEY=