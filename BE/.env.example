# ─── DB ─────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=DB유저명
DB_PASSWORD=DB비밀번호
DB_NAME=DB이름

# ─── 외부 RETINA API ────────────────────────────────────────────────
EXTERNAL_API_BASE_URL=https://외부api주소.com

# ─── AI 서버 ─────────────────────────────────────────────────
AI_SERVER_URL=http://ai:8001

# ─── 앱 ──────────────────────────────────────────────────────
# 배포 후에 아래 localhost:5173 부분을 실제 FE 주소로 변경 부탁드립니다!
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:5173"]

# ─── DB 컨테이너 생성용 ───────────────
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ─── AWS S3 ──────────────────────────
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=