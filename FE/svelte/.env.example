# RETINAL FE 환경 변수 예시
# 실제 값은 .env (운영) 또는 .env.development (로컬) 파일에 채워 넣는다.
# .env 류는 git 에 커밋되지 않는다.

# ── API ───────────────────────────────────────────────
# BE API base URL (예: https://api.retinal.example.com)
VITE_API_BASE_URL=/api

# ── S3 ────────────────────────────────────────────────
# 업로드된 사진의 공개 GET URL 호스트
# 예: https://{bucket}.s3.{region}.amazonaws.com
# upload_captures_to_s3() 가 object_key 와 합쳐 file_url 을 만들 때 사용한다.
VITE_S3_PUBLIC_HOST=

# ── 관리자 페이지 자격증명 ─────────────────────────────
# 비어 있으면 PROD 환경에서는 관리자 로그인이 항상 실패한다.
# DEV 모드에서는 코드 내 fallback 값(retinai1 / 1234)이 사용된다.
VITE_ADMIN_ID=
VITE_ADMIN_PASSWORD=
